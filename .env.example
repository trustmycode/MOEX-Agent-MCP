# Обязательный случайный ключ для связи веб-приложения с агентом.
AGENT_API_KEY=replace-with-a-long-random-value

# Безопасные значения по умолчанию.
AGENT_ENABLE_DEBUG=false
LOG_LEVEL=INFO

# OpenRouter. Без ключа агент использует локальные имитационные ответы.
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.7-flash
OPENROUTER_FALLBACK_MODEL=openai/gpt-5.6-luna
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=MOEX Market Analyst
