# Общие настройки
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Веб-интерфейс
WEB_PORT=3000
AGENT_SERVICE_URL=http://agent:8100/agui

# Агент (A2A)
AGENT_PORT=8100
AGENT_ENABLE_DEBUG=true
AGENT_STEP_TIMEOUT_SECONDS=120
MOEX_ISS_MCP_URL=https://a49ce896-2fbb-4180-a2ff-6bef32b6f44d-mcp-server.ai-agent.inference.cloud.ru
RISK_ANALYTICS_MCP_URL=https://9a888620-4ae0-47da-a875-00b5e26ffd0f-mcp-server.ai-agent.inference.cloud.ru

# OpenRouter. Для боевой среды передавайте ключ через хранилище секретов.
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.7-flash
OPENROUTER_FALLBACK_MODEL=openai/gpt-5.6-luna
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=MOEX Market Analyst

# moex-iss-mcp
PORT=8000
HOST=0.0.0.0
MOEX_ISS_BASE_URL=https://iss.moex.com/iss/
MOEX_ISS_RATE_LIMIT_RPS=3
MOEX_ISS_TIMEOUT_SECONDS=20
ENABLE_MONITORING=false
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=moex-iss-mcp
MOEX_API_KEY=

# risk-analytics-mcp
RISK_MCP_PORT=8010
RISK_MAX_PORTFOLIO_TICKERS=50
RISK_MAX_CORRELATION_TICKERS=20
RISK_MAX_PEERS=15
RISK_MAX_LOOKBACK_DAYS=365
RISK_ENABLE_MONITORING=false
RISK_OTEL_ENDPOINT=
RISK_OTEL_SERVICE_NAME=risk-analytics-mcp
RISK_DEFAULT_INDEX_TICKER=IMOEX
